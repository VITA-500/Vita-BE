# EC2 dev 서버에서만 사용. 로컬에선 이 파일 필요 없음(.env.local 사용).
# EC2에 이 내용으로 .env.dev를 만들어서 docker-compose.dev.yml이 참조하게 한다.
#   cp .env.dev.example .env.dev
# DB_PASSWORD는 실제 RDS 마스터 암호로 채울 것 — 이 example 파일엔 플레이스홀더만 남겨둔다.
# oauth 프로파일을 반드시 같이 켜야 소셜 로그인 설정(application.yml)이 로드된다.
SPRING_PROFILES_ACTIVE=dev,oauth
DB_URL=jdbc:postgresql://vita-db.cbouowac2f97.ap-northeast-2.rds.amazonaws.com:5432/vita_dev
DB_USERNAME=vita
DB_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=CHANGE_ME
LLM_PROVIDER=bedrock
# Bedrock 리전은 일부러 안 넣는다 — EC2/RDS는 ap-northeast-2(서울)지만, 쓰는 모델
# (openai.gpt-oss-*)이 서울엔 없고 도쿄(ap-northeast-1)에만 있어서 application.yml
# 기본값(ap-northeast-1)을 그대로 쓴다. RDS/EC2 리전과 다른 게 정상이니 맞추려고
# ap-northeast-2로 바꾸지 말 것 — 바꾸면 "모델을 찾을 수 없다" 에러가 다시 난다.
# 다른 모델/리전으로 바꿔야 하면 AWS_REGION을 여기서 명시적으로 오버라이드한다.
# AWS_REGION=ap-northeast-1

# Bedrock 호출용 자격증명 — 임시 조치. 원래는 EC2 인스턴스 프로필(IAM Role)로 키 없이
# 호출하는 게 정석이라, 인스턴스 프로필 설정이 끝나면 이 두 줄은 지워야 한다.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# 프론트 배포 URL. 콤마로 여러 origin 추가 가능 (예: 로컬 프론트 개발 시 http://localhost:3000).
CORS_ALLOWED_ORIGINS=https://vita-fe.vercel.app

# 소셜 로그인 — 각 개발자 콘솔에서 발급한 값을 팀 비공개 채널에서 받아 채운다.
# 카카오는 REST API 키를 쓴다(JavaScript 키 아님).
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
KAKAO_CLIENT_ID=CHANGE_ME
KAKAO_CLIENT_SECRET=CHANGE_ME
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME

# 소셜 인증 후 토큰을 실어 보낼 프론트 주소. 단일 값만 지원(로컬/배포 동시 지정 불가).
OAUTH2_REDIRECT_URI=https://vita-fe.vercel.app/oauth/callback

# 프론트(Vercel)와 백엔드(EC2) 도메인이 달라 쿠키 전송에 SameSite=None이 필요하고,
# 브라우저가 그 경우 Secure를 요구한다. dev는 HTTPS(8443)라 조건 충족됨.
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# 카카오 길찾기 REST API 키 — 소셜 로그인용 KAKAO_CLIENT_ID와는 별개.
KAKAO_REST_API_KEY=CHANGE_ME

# RAG 검색(질문 임베딩)용 TEI 서버 주소. docker-compose.dev.yml의 embedding 컨테이너를 가리킨다.
# 로컬(.env.local)의 host.docker.internal:8081과 다름 — EC2는 컨테이너 이름으로 접근해야 함.
EMBEDDING_BASE_URL=http://embedding:80
