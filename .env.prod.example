# EC2 prod 서버에서만 사용. 로컬에선 이 파일 필요 없음(.env.local 사용).
# EC2에 이 내용으로 .env.prod를 만들어서 docker-compose.prod.yml이 참조하게 한다.
#   cp .env.prod.example .env.prod
# DB_PASSWORD는 실제 RDS 마스터 암호로 채울 것 — 이 example 파일엔 플레이스홀더만 남겨둔다.
# oauth 프로파일을 반드시 같이 켜야 소셜 로그인 설정(application.yml)이 로드된다.
SPRING_PROFILES_ACTIVE=prod,oauth
DB_URL=jdbc:postgresql://vita-db.cbouowac2f97.ap-northeast-2.rds.amazonaws.com:5432/vita_prod
DB_USERNAME=vita
DB_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=CHANGE_ME
LLM_PROVIDER=bedrock
# Bedrock 리전은 일부러 안 넣는다 — dev와 동일한 이유(모델이 서울엔 없고 도쿄에만 있음).
# application.yml 기본값(ap-northeast-1) 그대로 사용. 자세한 내용은 .env.dev.example 참고.
# AWS_REGION=ap-northeast-1

# Bedrock 호출용 자격증명 — 임시 조치. 원래는 EC2 인스턴스 프로필(IAM Role)로 키 없이
# 호출하는 게 정석이라, 인스턴스 프로필 설정이 끝나면 이 두 줄은 지워야 한다.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# 프론트 배포 URL. 콤마로 여러 origin 추가 가능.
CORS_ALLOWED_ORIGINS=https://vita-fe.vercel.app

# 소셜 로그인 — 각 개발자 콘솔에서 발급한 값을 팀 비공개 채널에서 받아 채운다.
# dev와 같은 소셜 앱을 쓸지, prod 전용으로 새로 만들지는 팀 결정 필요.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
KAKAO_CLIENT_ID=CHANGE_ME
KAKAO_CLIENT_SECRET=CHANGE_ME
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME

# 소셜 인증 후 토큰을 실어 보낼 프론트 주소.
OAUTH2_REDIRECT_URI=https://vita-fe.vercel.app/oauth/callback

# 프론트(Vercel)와 백엔드(EC2) 도메인이 달라 쿠키 전송에 SameSite=None이 필요하고,
# 브라우저가 그 경우 Secure를 요구한다. prod는 HTTPS(443)라 조건 충족됨.
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# 카카오 길찾기 REST API 키 — 실제 값은 EC2의 .env.prod에만 넣고 이 example에는 커밋하지 않는다.
KAKAO_REST_API_KEY=CHANGE_ME

# ⚠️ EMBEDDING_BASE_URL은 아직 여기 없음 — docker-compose.prod.yml에 dev와 달리
# embedding(TEI) 서비스가 아직 없어서다. prod 승격 시 dev와 동일하게 임베딩 컨테이너를
# 추가하고 이 값(예: http://embedding:80)도 같이 넣어야 RAG 검색이 동작한다.
