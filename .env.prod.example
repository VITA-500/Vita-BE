# EC2 prod 서버에서만 사용. 로컬에선 이 파일 필요 없음(.env.local 사용).
# EC2에 이 내용으로 .env.prod를 만들어서 docker-compose.prod.yml이 참조하게 한다.
#   cp .env.prod.example .env.prod
# DB_PASSWORD는 실제 RDS 마스터 암호로 채울 것 — 이 example 파일엔 플레이스홀더만 남겨둔다.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://vita-db.cbouowac2f97.ap-northeast-2.rds.amazonaws.com:5432/vita_prod
DB_USERNAME=vita
DB_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=CHANGE_ME
LLM_PROVIDER=bedrock
AWS_REGION=ap-northeast-2
