# 09_인프라구성.md 2절 그대로. 복사해서 .env.local로 이름 바꾸고 값 채우기 (.env.local은 .gitignore 처리됨).
#   cp .env.local.example .env.local
#
# REDIS_HOST/PORT, JWT_SECRET, LLM_PROVIDER, AWS_REGION은 아직 코드에서 실제로 쓰이진 않지만
# (auth/chat 도메인 미구현 — Vita-BE/README.md 참고), 컨테이너(redis)는 이미 떠 있고 해당 도메인이
# 만들어지는 대로 바로 쓰게 될 값들이라 미리 넣어둔다. LLM_PROVIDER 값은 팀 결정 전 임시값.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://postgres:5432/vita_local
DB_USERNAME=vita
DB_PASSWORD=local1234
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=local-dev-secret-key
LLM_PROVIDER=bedrock
AWS_REGION=ap-northeast-2
