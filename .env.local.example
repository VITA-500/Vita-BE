# 09_인프라구성.md 2절 그대로. 복사해서 .env.local로 이름 바꾸고 값 채우기 (.env.local은 .gitignore 처리됨).
#   cp .env.local.example .env.local
#
# REDIS_HOST/PORT, JWT_SECRET, LLM_PROVIDER, AWS_REGION은 아직 코드에서 실제로 쓰이진 않지만
# (auth/chat 도메인 미구현 — Vita-BE/README.md 참고), 컨테이너(redis)는 이미 떠 있고 해당 도메인이
# 만들어지는 대로 바로 쓰게 될 값들이라 미리 넣어둔다. LLM_PROVIDER 값은 팀 결정 전 임시값.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://postgres:5432/vita_local
DB_USERNAME=vita
DB_PASSWORD=local1234
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=local-dev-secret-key-change-me-in-production-32bytes
LLM_PROVIDER=bedrock
AWS_REGION=ap-northeast-2
# FE 로컬 개발 서버(Next.js 기본 포트) 기준. 콤마로 여러 origin 추가 가능.
# FE 개발서버 포트. Vite는 5173, CRA/Next는 3000 — 둘 다 열어두어 누구든 바로 붙는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FAQ_IMPORT_ENABLED=true
# docker-compose.embedding.yml을 별도로 띄운 뒤 backend 컨테이너에서 호스트 8081로 접근한다.
EMBEDDING_BASE_URL=http://host.docker.internal:8081
FAQ_EMBEDDING_ENABLED=false
FAQ_EMBEDDING_BATCH_SIZE=100

# 소셜 로그인 — 각 개발자 콘솔에서 발급. 카카오는 REST API 키를 쓴다(JavaScript 키 아님).
# 콘솔의 Redirect URI에 http://localhost:8080/login/oauth2/code/{google|kakao|naver} 등록 필요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 소셜 인증 후 토큰을 실어 보낼 프론트 주소 (FE 콜백 경로 확정 시 수정)
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback

# 길찾기(카카오모빌리티/카카오맵 경로 API)용 REST API 키. 소셜 로그인용 KAKAO_CLIENT_ID와는 별개.
# 실제 값은 커밋하지 말고 팀 비공개 채널에서 받아 .env.local에만 넣는다.
KAKAO_REST_API_KEY=

# 요금제 description 임베딩 (V8/V9 적용 후, FAQ와 독립적으로 실행)
PLAN_EMBEDDING_ENABLED=false
PLAN_EMBEDDING_BATCH_SIZE=100
